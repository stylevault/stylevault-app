<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme -->
    <style name="Theme.StyleVault" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/plum_primary</item>
        <item name="colorPrimaryVariant">@color/plum_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/plum_dark</item>
        <item name="android:navigationBarColor">@color/plum_dark</item>
        <item name="android:windowBackground">@color/plum_dark</item>
    </style>

    <!-- Animated Splash Screen Theme -->
    <style name="Theme.StyleVault.Splash" parent="Theme.StyleVault">
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@color/plum_dark</item>
        <item name="android:navigationBarColor">@color/plum_dark</item>
        <item name="android:windowBackground">@color/plum_dark</item>
    </style>
</resources>

